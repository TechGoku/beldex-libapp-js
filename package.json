{
  "name": "beldex-libapp-js",
  "version": "1.0.0",
  "description": "The JS library containing the JS transpilation of the shared library behind the Beldex apps",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beldex-Coin/beldex-libapp-js.git"
  },
  "scripts": {
    "build": "docker run --rm -it -v $(pwd):/app -w /app techgoku/beldex-libapp:0.1 ./bin/archive-emcpp.sh",
    "format": "find . -name '*.js*' | xargs prettier --write --config ./.prettierrc --config-precedence file-override",
    "test": "mocha"
  },
  "keywords": [
    "beldex",
    "bdx",
    "javascript",
    "js",
    "lightweight",
    "lightwallet",
    "wallet",
    "crypto",
    "script",
    "utility",
    "tool"
  ],
  "author": "Beldex",
  "license": "See LICENSE.TXT. Copyright (c) 2018-2025, Beldex. All rights reserved.",
  "bugs": {
    "url": "https://github.com/Beldex-Coin/beldex-libapp-js/issues"
  },
  "homepage": "https://github.com/Beldex-Coin/beldex-libapp-js#readme",
  "dependencies": {},
  "devDependencies": {
    "mocha": "5.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "coveragePathIgnorePatterns": [
      "node_modules",
      "beldex_utils/BeldexLibAppCpp_WASM.js",
      "beldex_utils/BeldexLibAppCpp_ASMJS.js",
      "beldex_utils/BeldexLibAppCpp_ASMJS.asm.js"
    ]
  }
}
